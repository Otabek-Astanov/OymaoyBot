# Telegram: common token or separate bot tokens. Empty separate tokens use BOT_TOKEN.
BOT_TOKEN=your_bot_token_here
HARID_BOT_TOKEN=
SOTUV_BOT_TOKEN=
HARAJAT_BOT_TOKEN=
ADMIN_IDS=
CHANNEL_ID=
GROUP_HARID_ID=
GROUP_SOTUV_ID=

# Google: paths must be readable by the runtime user.
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/credentials.json
SPREADSHEET_ID=
DRIVE_FOLDER_ID=
DRIVE_TOKEN_FILE=/app/data/token.json
MEDIA_DIR=/app/media

# Durable runtime. Redis is mandatory; no memory fallback.
# Serverda Redis majburiy. Faqat lokal sinov uchun: FSM_STORAGE_URL=memory://
FSM_STORAGE_URL=redis://redis:6379/0
FSM_TTL_SECONDS=86400
OPERATION_DB_PATH=/app/data/operations.sqlite
IO_TIMEOUT_SECONDS=45
IO_MAX_PENDING=64
DROP_PENDING_UPDATES=false
